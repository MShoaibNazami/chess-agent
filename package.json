{
  "name": "chess-agent-extension",
  "version": "1.0.0",
  "description": "Chrome/Chromium chess analysis extension for learning, authorized board recognition, and game review",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-fen": "node scripts/validate-fen.js"
  },
  "keywords": [
    "chess",
    "chess-agent",
    "stockfish",
    "uci",
    "chrome-extension",
    "manifest-v3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "stockfish": "^19.0.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
